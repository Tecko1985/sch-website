# Erzeugt von werkzeuge/weiterleitungen.py – nicht von Hand ändern, neu erzeugen.
# Alte Adressen der WordPress-Seite -> neue Seite (301 = dauerhaft umgezogen).
# Wirkt erst auf dem Webspace (Apache), auf GitHub Pages nicht.
# --- Adresse, Fehlerseite, Schutz, Tempo (Live-Prüfung 17.11.2026, L-1/L-2/L-4/L-5/P-1/P-2) ---
# Immer verschlüsselt und immer mit www (eine Adresse für Google, Redaktion und Browser-Speicher)
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.sc1911-heiligenstadt.de%{REQUEST_URI} [R=301,L,NE]
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>
# Kurz genug, dass neue Fassungen ohne ?v= (z. B. neu.js) am selben Tag ankommen
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 hour"
ExpiresByType text/javascript "access plus 1 hour"
ExpiresByType application/javascript "access plus 1 hour"
ExpiresByType application/json "access plus 1 hour"
ExpiresByType image/webp "access plus 7 days"
ExpiresByType image/jpeg "access plus 7 days"
ExpiresByType image/png "access plus 7 days"
ExpiresByType image/svg+xml "access plus 7 days"
ExpiresByType font/woff2 "access plus 30 days"
ExpiresByType font/woff "access plus 30 days"
ExpiresByType application/pdf "access plus 1 day"
</IfModule>
# --- Ende ---

RewriteEngine On

# Kategorien, Schlagworte, Feeds und Seitenzahlen der News -> News-Liste
RewriteRule ^(category|tag|author)/ /seiten/news.html [R=301,L]
RewriteRule ^(feed|comments/feed)/?$ /seiten/news.html [R=301,L]
RewriteRule ^page/[0-9]+/?$ /seiten/news.html [R=301,L]
# Beiträge bis Juni 2025 (nur noch im Nextcloud-Archiv) -> News-Archiv
RewriteRule ^(2021|2022|2023|2024)/[0-9]{2}/[0-9]{2}/ /seiten/archiv.html [R=301,L]
RewriteRule ^2025/0[1-6]/[0-9]{2}/ /seiten/archiv.html [R=301,L]
# Dokumente (PDF) der alten Seite -> assets/dokumente/
RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/1SC\-Heiligenstadt\-Flyer\-A5\-hoch\-Wandern\-2025\-W\.pdf$ /assets/dokumente/1SC-Heiligenstadt-Flyer-A5-hoch-Wandern-2025-W.pdf [R=301,L]
RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/Mitgliedsantrag\-neu\-PDF\.pdf$ /assets/dokumente/Mitgliedsantrag-neu-PDF.pdf [R=301,L]
RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/Programmheft\.pdf$ /assets/dokumente/Programmheft.pdf [R=301,L]
RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/konzeptpapier\-nachwuchsfoerderung\.pdf$ /assets/dokumente/konzeptpapier-nachwuchsfoerderung.pdf [R=301,L]
RewriteRule ^wp-content/uploads/[0-9]{4}/[0-9]{2}/wanderplan\-2027\.pdf$ /assets/dokumente/wanderplan-2027.pdf [R=301,L]

